using System;

namespace AgendaTurnosClinica
{
    class Program
    {
        // Estructura para representar un paciente
        struct Paciente
        {
            public string nombre;
            public string cedula;
            public int edad;
            public string especialidad;
            public string turnoAsignado;
        }

        static void Main(string[] args)
        {
            const int maxPacientes = 10;
            Paciente[] pacientes = new Paciente[maxPacientes];
            string[,] agenda = new string[5, 2]; // 5 días, 2 turnos por día
            int contador = 0;

            Console.WriteLine("---- AGENDA DE TURNOS MÉDICOS ----");

            while (contador < maxPacientes)
            {
                Console.WriteLine($"\nRegistro del paciente #{contador + 1}");

                Paciente p;
                Console.Write("Nombre: ");
                p.nombre = Console.ReadLine();

                Console.Write("Cédula: ");
                p.cedula = Console.ReadLine();

                Console.Write("Edad: ");
                p.edad = Convert.ToInt32(Console.ReadLine());

                Console.Write("Especialidad (Ej: Pediatría, Medicina General): ");
                p.especialidad = Console.ReadLine();

                // Asignar turno disponible
                bool turnoAsignado = false;

                for (int dia = 0; dia < 5 && !turnoAsignado; dia++)
                {
                    for (int hora = 0; hora < 2; hora++)
                    {
                        if (agenda[dia, hora] == null)
                        {
                            agenda[dia, hora] = p.nombre;
                            p.turnoAsignado = $"Día {dia + 1} - Turno {(hora == 0 ? "Mañana" : "Tarde")}";
                            turnoAsignado = true;
                            break;
                        }
                    }
                }

                if (!turnoAsignado)
                {
                    Console.WriteLine("No hay turnos disponibles.");
                    break;
                }

                pacientes[contador] = p;
                contador++;

                Console.Write("¿Desea registrar otro paciente? (s/n): ");
                string continuar = Console.ReadLine().ToLower();
                if (continuar != "s") break;
            }

            Console.WriteLine("\n---- LISTADO DE TURNOS ASIGNADOS ----");
            for (int i = 0; i < contador; i++)
            {
                Console.WriteLine($"Paciente: {pacientes[i].nombre} | Turno: {pacientes[i].turnoAsignado}");
            }

            Console.WriteLine("\nGracias por usar el sistema de turnos.");
        }
    }
}

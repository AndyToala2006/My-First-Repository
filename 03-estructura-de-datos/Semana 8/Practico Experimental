using System;
using System.Collections.Generic;

namespace AsignacionAsientos
{
    // Clase Persona
    class Persona
    {
        public string Nombre { get; set; }
        public int NumeroAsiento { get; set; }

        public Persona(string nombre, int numeroAsiento)
        {
            Nombre = nombre;
            NumeroAsiento = numeroAsiento;
        }

        public override string ToString()
        {
            return $"Asiento #{NumeroAsiento} - {Nombre}";
        }
    }

    // Clase Sistema de Asignación
    class SistemaAsignacion
    {
        private Queue<Persona> cola = new Queue<Persona>();
        private int capacidadMaxima = 30;
        private int contadorAsiento = 1;

        public void AgregarPersona(string nombre)
        {
            if (cola.Count < capacidadMaxima)
            {
                Persona persona = new Persona(nombre, contadorAsiento);
                cola.Enqueue(persona);
                Console.WriteLine($"✔️ {nombre} ha sido asignado al asiento #{contadorAsiento}");
                contadorAsiento++;
            }
            else
            {
                Console.WriteLine($"❌ Lo sentimos, {nombre}, todos los asientos han sido ocupados.");
            }
        }

        public void MostrarCola()
        {
            Console.WriteLine("\n📋 Lista de personas en la cola:");
            foreach (Persona p in cola)
            {
                Console.WriteLine(p);
            }
        }
    }

    // Clase Principal
    class Program
    {
        static void Main(string[] args)
        {
            SistemaAsignacion sistema = new SistemaAsignacion();
            Console.WriteLine("🎢 Bienvenido al sistema de asignación de asientos\n");

            while (true)
            {
                Console.Write("Ingrese el nombre de la persona (o escriba 'salir'): ");
                string nombre = Console.ReadLine();

                if (nombre.ToLower() == "salir")
                    break;

                sistema.AgregarPersona(nombre);
            }

            sistema.MostrarCola();
            Console.WriteLine("\n✅ Asignación finalizada. ¡Gracias por participar!");
        }
    }
}

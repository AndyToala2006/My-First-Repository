using System;
using System.Collections.Generic;

class Numeros
{
    public List<int> ListaNumeros { get; set; }

    public Numeros()
    {
        ListaNumeros = new List<int>();
        for (int i = 1; i <= 10; i++)
        {
            ListaNumeros.Add(i);
        }
    }

    public void MostrarInvertido()
    {
        ListaNumeros.Reverse();
        Console.WriteLine(string.Join(", ", ListaNumeros));
    }
}

class Program
{
    static void Main()
    {
        Numeros numeros = new Numeros();
        numeros.MostrarInvertido();
    }
}
